{
  "additionalProperties": false,
  "description": "A per-book reading session row.",
  "properties": {
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "book_session_id": {
      "pattern": "^book_[A-Za-z0-9]+$",
      "title": "Book Session Id",
      "type": "string"
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    },
    "session_id": {
      "pattern": "^sess_[A-Za-z0-9]+$",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "closed"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "book_session_id",
    "session_id",
    "title",
    "started_at"
  ],
  "title": "BookSession",
  "type": "object"
}