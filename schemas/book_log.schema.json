{
  "$defs": {
    "BookLogEntry": {
      "additionalProperties": false,
      "description": "One lookup inside a ``tutor book log`` result.",
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "word",
            "sentence",
            "passage",
            "question"
          ],
          "title": "Kind",
          "type": "string"
        },
        "lookup_id": {
          "pattern": "^lookup_[A-Za-z0-9]+$",
          "title": "Lookup Id",
          "type": "string"
        },
        "rendered": {
          "title": "Rendered",
          "type": "string"
        }
      },
      "required": [
        "lookup_id",
        "kind",
        "content",
        "created_at",
        "rendered"
      ],
      "title": "BookLogEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output of ``tutor book log`` — ordered lookups + a rendered numbered list.",
  "properties": {
    "book_session_id": {
      "pattern": "^book_[A-Za-z0-9]+$",
      "title": "Book Session Id",
      "type": "string"
    },
    "lookups": {
      "items": {
        "$ref": "#/$defs/BookLogEntry"
      },
      "title": "Lookups",
      "type": "array"
    },
    "rendered": {
      "title": "Rendered",
      "type": "string"
    }
  },
  "required": [
    "book_session_id",
    "lookups",
    "rendered"
  ],
  "title": "BookLog",
  "type": "object"
}