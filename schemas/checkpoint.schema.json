{
  "$defs": {
    "CheckpointModality": {
      "enum": [
        "lesson",
        "reading",
        "transcript",
        "vocab",
        "writing",
        "progress",
        "book"
      ],
      "title": "CheckpointModality",
      "type": "string"
    },
    "CheckpointStepKind": {
      "enum": [
        "started",
        "prompt_shown",
        "feedback_shown",
        "progress_shown",
        "answer_recorded"
      ],
      "title": "CheckpointStepKind",
      "type": "string"
    },
    "SafeStepState": {
      "additionalProperties": false,
      "description": "Bounded safe step metadata for a checkpoint. NOT a catch-all dict.",
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Labels",
          "type": "array"
        },
        "modality_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modality Hint"
        },
        "prompt_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Ref"
        },
        "step_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Index"
        },
        "total_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Steps"
        }
      },
      "title": "SafeStepState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable per-step checkpoint anchored to an open session (FR-002, FR-005).",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^ckpt_[A-Za-z0-9]+$",
      "title": "Id",
      "type": "string"
    },
    "modality": {
      "$ref": "#/$defs/CheckpointModality"
    },
    "prompt_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Ref"
    },
    "session_id": {
      "pattern": "^sess_[A-Za-z0-9]+$",
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SafeStepState"
    },
    "step_kind": {
      "$ref": "#/$defs/CheckpointStepKind"
    },
    "summary": {
      "maxLength": 280,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "modality",
    "step_kind",
    "state",
    "summary",
    "created_at"
  ],
  "title": "Checkpoint",
  "type": "object"
}