{
  "$defs": {
    "HostId": {
      "enum": [
        "hermes",
        "openclaw",
        "claude",
        "codex"
      ],
      "title": "HostId",
      "type": "string"
    },
    "SessionStatus": {
      "description": "Stored session status. ``stale``/``abandoned`` are derived labels only.",
      "enum": [
        "open",
        "closed"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Stored tutor session (FR-001, FR-004, FR-007).\n\nStatus is only ``open`` or ``closed``; ``stale``/``abandoned`` are derived\nat read time and never persisted (FR-018).",
  "properties": {
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed At"
    },
    "host": {
      "$ref": "#/$defs/HostId"
    },
    "host_conversation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host Conversation Id"
    },
    "id": {
      "pattern": "^sess_[A-Za-z0-9]+$",
      "title": "Id",
      "type": "string"
    },
    "last_seen_at": {
      "format": "date-time",
      "title": "Last Seen At",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus"
    }
  },
  "required": [
    "id",
    "host",
    "status",
    "started_at",
    "last_seen_at"
  ],
  "title": "Session",
  "type": "object"
}