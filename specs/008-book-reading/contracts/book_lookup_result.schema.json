{
  "additionalProperties": false,
  "description": "Output of ``tutor book record`` — the persisted lookup + rendered markdown.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deduped": {
      "title": "Deduped",
      "type": "boolean"
    },
    "lookup_id": {
      "pattern": "^lookup_[A-Za-z0-9]+$",
      "title": "Lookup Id",
      "type": "string"
    },
    "rendered": {
      "title": "Rendered",
      "type": "string"
    },
    "vocab_item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vocab Item Id"
    }
  },
  "required": [
    "lookup_id",
    "deduped",
    "created_at",
    "rendered"
  ],
  "title": "BookLookupResult",
  "type": "object"
}